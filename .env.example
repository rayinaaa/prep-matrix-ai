# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-trao-assessment-2026

# Database (Optional: Auto-falls back to local SQLite/JSON persistence if MongoDB URI is not provided)
MONGODB_URI=mongodb://localhost:27017/trao_interview_prep

# AI / LLM Configuration
# Primary: Google Gemini API (Free tier supported: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Alternative LLM Provider (Groq / OpenAI compatible fallback)
GROQ_API_KEY=
OPENAI_API_KEY=

# Client Base URL (For CORS & Auth redirects)
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
