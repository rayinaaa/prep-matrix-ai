{
  "name": "trao-ai-interview-prep-kit",
  "version": "1.0.0",
  "description": "Full-Stack AI Interview Preparation Kit - Trao Assessment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "next dev -p 3000",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"tsx watch server/index.ts\" \"next dev -p 3000\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "next build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "evaluate": "tsx batch/evaluate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "minimist": "^1.2.8",
    "mongoose": "^8.10.1",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
